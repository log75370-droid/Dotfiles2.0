{
    "$schema": "https://github.com",
    "logo": {
        "source": "blackarch",
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "type": "custom",
            "format": "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
        },
        {
            "type": "os",
            "key": "│     OS     >",
            "keyColor": "31"
        },
        {
            "type": "shell",
            "key": "│     SH     >",
            "keyColor": "31"
        },
        {
            "type": "wm",
            "key": "│     WM     >",
            "keyColor": "31"
        },
        {
            "type": "terminal",
            "key": "│     TERM   >",
            "keyColor": "31"
        },
        {
            "type": "custom",
            "format": "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
        }
    ]
}
